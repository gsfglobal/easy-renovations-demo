{
  "name": "renovation-premium-template",
  "version": "1.0.0",
  "private": true,
  "description": "RENOVATION \u2014 Premium Website Template per imprese di ristrutturazione",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "validate": "tsx scripts/validate-config.mts",
    "validate:prod": "SITE_MODE=production tsx scripts/validate-config.mts",
    "check:links": "node scripts/check-links.mjs",
    "qa": "npm run validate && npm run typecheck && npm run lint && npm run build",
    "build:pages": "STATIC_EXPORT=1 next build && node scripts/fix-pages.mjs"
  },
  "engines": {
    "node": ">=20.9"
  },
  "dependencies": {
    "@react-three/fiber": "^9.8.2",
    "clsx": "^2.1.1",
    "lucide-react": "^1.77.0",
    "motion": "^14.14.0",
    "next": "^16.4.6",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwind-merge": "^3.7.1",
    "three": "^0.187.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.5",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.187.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.4.6",
    "tailwindcss": "^4.3.5",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3"
  }
}
